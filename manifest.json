{
  "manifest_version": 3,
  "name": "LinkedIn Profile Analyzer",
  "version": "1.0",
  "description": "Real-time analysis of LinkedIn profiles.",
  "permissions": ["storage", "activeTab", "scripting", "sidePanel"],
  
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/in/*"],
      "js": ["content.js"]
    }
  "side_panel": {
    "default_path": "analyzer.html"
  },
  ]
}
